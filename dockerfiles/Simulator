FROM debian:bookworm-slim AS build

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       ca-certificates cmake g++ ninja-build \
       libasound2-dev libgl1-mesa-dev libx11-dev libxrandr-dev \
       libxi-dev libxcursor-dev libxinerama-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY CMakeLists.txt ./
COPY src/ ./src/
RUN cmake -S . -B /build -G Ninja -DCMAKE_BUILD_TYPE=Release \
    && cmake --build /build --parallel

FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       libstdc++6 libasound2 libgl1 libx11-6 libxrandr2 libxi6 \
       libxcursor1 libxinerama1 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /build/mic1-simulator /usr/local/bin/mic1-simulator
WORKDIR /data
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/mic1-simulator"]
