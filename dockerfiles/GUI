FROM debian:bookworm-slim AS build

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       ca-certificates cmake g++ git ninja-build \
       libasound2-dev libgl1-mesa-dev libx11-dev libxrandr-dev \
       libxi-dev libxcursor-dev libxinerama-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY gui/ ./gui/
COPY simulator/src/ ./simulator/src/

RUN cmake -S gui -B /build/gui -G Ninja -DCMAKE_BUILD_TYPE=Release \
    && cmake --build /build/gui --parallel

FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       libstdc++6 libasound2 libgl1 libx11-6 libxrandr2 libxi6 \
       libxcursor1 libxinerama1 fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /build/gui/mic3_gui /usr/local/bin/mic3_gui
WORKDIR /data
ENTRYPOINT ["/usr/local/bin/mic3_gui"]
